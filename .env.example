HACKTITLAN_ENVIRONMENT=development
HACKTITLAN_DATABASE_URL=postgresql+psycopg://hacktitlan_app:change-me@127.0.0.1:5432/hacktitlan
HACKTITLAN_TEST_DATABASE_URL=postgresql+psycopg://hacktitlan_app:change-me@127.0.0.1:5432/hacktitlan_test
HACKTITLAN_STORAGE_ROOT=C:\ProgramData\Hacktitlan\storage
HACKTITLAN_BACKUP_ROOT=C:\ProgramData\Hacktitlan\backups
HACKTITLAN_SECONDARY_BACKUP_ROOT=
HACKTITLAN_API_HOST=127.0.0.1
HACKTITLAN_API_PORT=8765
HACKTITLAN_MAX_PDF_BYTES=104857600
HACKTITLAN_WORKSTATION_NAME=
HACKTITLAN_OCR_ENABLED=false
HACKTITLAN_OCR_DEVICE=auto
HACKTITLAN_OCR_LANGUAGE=en
HACKTITLAN_OCR_MIN_CONFIDENCE=0.50
HACKTITLAN_OCR_CPU_THREADS=4

HACKTITLAN_CORS_ORIGINS=["http://tauri.localhost","tauri://localhost","http://localhost:1420"]
